# Copy to .env (gitignored) and fill in. No secrets belong in the repo.

# --- MCP server (what a user of the package needs) ---------------------------
# Endpoint of the hosted model-chef API.
MODEL_CHEF_API_URL=https://api.model-chef.dev
# Key for the model-chef API itself. This is NOT an LLM provider key —
# model-chef never calls a model provider on your behalf.
MODEL_CHEF_API_KEY=

# 'snippet_only' truncates every result. 'license_aware' serves full text for
# permissively licensed sources only. See docs/ARCHITECTURE.md > Output policy.
MODEL_CHEF_OUTPUT_POLICY=snippet_only

# --- Ingestion (maintainer only; not needed to use the package) --------------
# Optional: raises Semantic Scholar's rate limit. Unauthenticated works too.
SEMANTIC_SCHOLAR_API_KEY=
# Cloudflare, for writing the index.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
